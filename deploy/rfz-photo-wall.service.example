[Unit]
Description=RFZ Photo Wall FastAPI service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/rfz-photo-wall/backend
EnvironmentFile=/var/www/rfz-photo-wall/backend/.env
ExecStart=/var/www/rfz-photo-wall/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
